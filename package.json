{
  "name": "@blockmatic/basilic-skills",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Basilic-maintained Agent Skills catalog",
  "scripts": {
    "lint": "pnpm lint:biome && pnpm lint:eslint",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "format": "biome format . --write",
    "validate": "node scripts/validate-catalog.mjs",
    "checktypes": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.13.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-turbo": "^2.10.12",
    "globals": "^17.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
